<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>net.shapechange</groupId>
	<artifactId>AAATools</artifactId>
	<version>2.0.6-SNAPSHOT</version>

	<name>AAA Tools</name>
	<description>ShapeChange extensions for processing the AFIS-ALKIS-ATKIS
		(AAA) application schema</description>
	<url>https://github.com/ShapeChange/AAATools</url>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/ShapeChange/AAATools/issues</url>
	</issueManagement>

	<licenses>
		<license>
			<name>GPL-3.0-only</name>
			<url>https://www.gnu.org/licenses/gpl-3.0.en.html</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Johannes Echterhoff</name>
			<email>echterhoff@interactive-instruments.de</email>
			<organization>interactive instruments</organization>
			<organizationUrl>https://www.interactive-instruments.de</organizationUrl>
		</developer>
		<developer>
			<name>Clemens Portele</name>
			<email>portele@interactive-instruments.de</email>
			<organization>interactive instruments</organization>
			<organizationUrl>https://www.interactive-instruments.de</organizationUrl>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/ShapeChange/AAATools</url>
		<connection>scm:git:https://github.com/ShapeChange/AAATools.git</connection>
		<developerConnection>scm:git:https://github.com/ShapeChange/AAATools.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<repositories>
		<repository>
			<id>central</id>
			<name>Central Repository</name>
			<url>https://repo1.maven.org/maven2</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>net.sf.saxon</groupId>
			<artifactId>Saxon-HE</artifactId>
			<version>12.9</version>
		</dependency>
		<!--		<dependency>-->
		<!--			<groupId>commons-beanutils</groupId>-->
		<!--			<artifactId>commons-beanutils</artifactId>-->
		<!--			<version>1.11.0</version>-->
		<!--			<scope>compile</scope>-->
		<!--		</dependency>-->
		<dependency>
			<groupId>net.shapechange</groupId>
			<artifactId>shapechange-core</artifactId>
			<version>4.1.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>net.shapechange</groupId>
			<artifactId>shapechange-app</artifactId>
			<version>4.1.0-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>${project.basedir}/src/main/resources</directory>
				<includes>
					<include>**/*.xsl</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>9.0.2</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
				<configuration>
					<dotGitDirectory>${project.basedir}/.git</dotGitDirectory>
					<dateFormatTimeZone>${user.timezone}</dateFormatTimeZone>
					<skipPoms>false</skipPoms>
					<verbose>false</verbose>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
				<configuration>
					<release>21</release>
					<showWarnings>true</showWarnings>
					<showDeprecation>true</showDeprecation>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>testResults</directory>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<doclint>-missing</doclint>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<excludeResources>true</excludeResources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<version>3.2.8</version>
				<executions>
					<execution>
						<id>sign-artifacts</id>
						<phase>verify</phase>
						<goals>
							<goal>sign</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.10.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
<!--					<skipPublishing>true</skipPublishing>-->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<executions>
					<execution>
						<id>default-jar</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<archive>
								<manifest>
									<mainClass>
										de.interactive_instruments.shapechange.app.Main</mainClass>
									<addClasspath>true</addClasspath>
									<classpathPrefix>lib</classpathPrefix>
									<!-- Workaround for Maven bug #MJAR-156
									(https://issues.apache.org/jira/browse/MJAR-156) -->
									<!-- to prevent snapshot file names in
									manifest classpath (having date suffix), set
									useUniqueVersions to fals
                       for further details, see
									https://stackoverflow.com/questions/45642451/classnotfoundexception-despite-the-manifest-classpath-including-a-jar-which-con/45642898#45642898
                   -->
									<useUniqueVersions>false</useUniqueVersions>
								</manifest>
								<manifestEntries>
									<Project-Version>${project.version}</Project-Version>
									<Git-Revision>${git.commit.id}</Git-Revision>
									<Build-Timestamp>${build.timestamp}</Build-Timestamp>
									<Build-Branch>${git.branch}</Build-Branch>
								</manifestEntries>
							</archive>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<overWriteReleases>true</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
							<excludeArtifactIds>Saxon-HE</excludeArtifactIds>
						</configuration>
					</execution>
					<execution>
						<?m2e ignore?>
						<id>resource-dependencies-1</id>
						<phase>package</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>net.shapechange</groupId>
									<artifactId>shapechange-core</artifactId>
									<type>jar</type>
								</artifactItem>
							</artifactItems>
							<includes>
								**/StandardMapEntries_iso19136_2007.xml,**/StandardMapEntries_iso19139_2007.xml,**/StandardMapEntries_iso19107.xml,**/StandardMapEntries_iso19108.xml,**/StandardMapEntries_iso19111.xml,**/StandardMapEntries_iso19115.xml,**/StandardMapEntries_iso19123.xml,**/StandardMapEntries_gmlcov.xml</includes>
							<outputDirectory>
								${project.build.directory}/appassembler/config-sc</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<?m2e ignore?>
						<id>resource-dependencies-2</id>
						<phase>package</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>net.shapechange</groupId>
									<artifactId>shapechange-core</artifactId>
									<type>jar</type>
								</artifactItem>
							</artifactItems>
							<includes>
								**/ShapeChangeAppinfo.xsd,**/ShapeChangeConfiguration.xsd,**/ShapeChangeResult.xsd</includes>
							<outputDirectory>
								${project.build.directory}/appassembler/schema-sc</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-resources1</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/config</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/config</directory>
									<includes>
										<include>
											AAAKatalog-AFIS-7.1.2-Aenderungen-SCXML.xml</include>
										<include>AAAKatalog-AFIS-7.1.2-SCXML.xml</include>
										<include>AAAKatalog-AK-2.0.0-SCXML.xml</include>
										<include>
											AAAKatalog-ALKIS-7.1.2-Aenderungen-SCXML.xml</include>
										<include>
											AAAKatalog-ALKIS-7.1.2-SCXML.xml</include>
										<include>
											AAAKatalog-ALKIS-Basis-DLM-7.1.2-SCXML.xml</include>
										<include>AAAKatalog-AS-7.1.2-SCXML.xml</include>
										<include>
											AAAKatalog-AS-7.1.2_ohne_Nutzungsartkennung-SCXML.xml</include>
										<include>
											AAAKatalog-BasisDLM-7.1.2-Aenderungen-SCXML.xml</include>
										<include>
											AAAKatalog-BasisDLM-7.1.2-SCXML.xml</include>
										<include>AAAKatalog-BR-3.0.1-SCXML.xml</include>
										<include>
											AAAKatalog-DLM50-7.1.2-Aenderungen-SCXML.xml</include>
										<include>
											AAAKatalog-DLM50-7.1.2-SCXML.xml</include>
										<include>AAAKatalog-GN-1.0.0-SCXML.xml</include>
										<include>AAAKatalog-GV-1.0.0-SCXML.xml</include>
										<include>
											AAAKatalog-LB-1.0.1-Aenderungen-SCXML.xml</include>
										<include>AAAKatalog-LB-1.0.1-SCXML.xml</include>
										<include>
											AAAKatalog-LN-1.0.2-Aenderungen-SCXML.xml</include>
										<include>AAAKatalog-LN-1.0.2-SCXML.xml</include>
										<include>AAAProfil-7.1.2.xml</include>
										<include>
											AAAProfil-Basis-DLM-7.1.2-SCXML.xml</include>
										<include>AAAProfil-DLKM-7.1.2-SCXML.xml</include>
										<include>Export-6.0.1.xml</include>
										<include>Export-7.1.2.xml</include>
										<include>
											GIDUmlProfile-StereotypeAliases.xml</include>
										<include>GIDUmlProfile-TagAliases.xml</include>
										<include>Input-SCXML-7.1.2.xml</include>
										<include>
											Input-SCXML-7.1.2_ohne_Nutzungsartkennung.xml</include>
										<include>NAS-7.1.2.xml</include>
										<include>NAS-AK-2.0.0.xml</include>
										<include>NAS-BR-3.0.1.xml</include>
										<include>NAS-GN-1.0.0.xml</include>
										<include>NAS-GV-1.0.0.xml</include>
										<include>NAS-LB-1.0.1.xml</include>
										<include>NAS-LN-1.0.2.xml</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources2</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/appassembler/shell</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/bat</directory>
									<filtering>true</filtering>
									<includes>
										<include>katalog_afis.bat</include>
										<include>katalog_alkis.bat</include>
										<include>katalog_basisdlm.bat</include>
										<include>katalog_dlm50.bat</include>
										<include>alles.bat</include>
										<include>profil.bat</include>
										<include>export_scxml.bat</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources4</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/appassembler/doc</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/documentation</directory>
									<includes>
										<include>AAA-Tools-Dokumentation.docx</include>
										<include>Lizenzbedingungen zur Nutzung
											von Softwareskripten.docx</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources5</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/schema</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/schema</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources6</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/out</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/out</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources7</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/model</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/model</directory>
									<includes>
										<include>AAA-6.0.1.qea</include>
										<include>AAA-7.1.0.qea</include>
										<include>AAA-7.1.1.qea</include>
										<include>AAA-7.1.2.qea</include>
										<include>GeoInfoDok.qea</include>
										<include>AAA-6.0.1.xml.zip</include>
										<include>AAA-7.1.0.xml.zip</include>
										<include>AAA-7.1.1.xml.zip</include>
										<include>AAA-7.1.2.xml.zip</include>
										<include>GeoInfoDok.zip</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources8</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/templates</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/templates</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resources9</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/xslt</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/xslt</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-resourcesA</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<includeEmptyDirs>true</includeEmptyDirs>
							<outputDirectory>
								${project.build.directory}/appassembler/uml-profile</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}/src/main/resources/uml-profile</directory>
									<includes>
										<include>AAA-Diagram.xml</include>
										<include>AAA-MDG.qea</include>
										<include>AAA-MDG.xml</include>
										<include>AAA-Profile.xml</include>
										<include>AAA-Toolbox.xml</include>
										<include>AAA.bmp</include>
										<include>AAA.mts</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>create-zip</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<descriptors>
								<descriptor>assembly.xml</descriptor>
							</descriptors>
							<appendAssemblyId>false</appendAssemblyId>
							<attach>false</attach>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
			</plugin>
		</plugins>
	</build>
</project>

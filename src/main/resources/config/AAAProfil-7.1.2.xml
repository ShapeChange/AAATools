		<stereotypeAliases>
			<StereotypeAlias wellknown="Application Schema" alias="applicationSchema" />
			<StereotypeAlias wellknown="Application Schema" alias="schema" />
			<StereotypeAlias wellknown="Application Schema" alias="requirementsClass" />
			<StereotypeAlias wellknown="Application Schema" alias="ApplicationSchema" />
			<StereotypeAlias wellknown="Application Schema" alias="Schema" />
			<StereotypeAlias wellknown="Type" alias="interface" />
			<StereotypeAlias wellknown="" alias="abstract" />
		</stereotypeAliases>
	</input>
	<dialog>
		<parameter name="dialogClass" value="de.adv_online.aaa.profiltool.ProfilDialog"/>
	</dialog>
	<log>
		<parameter name="reportLevel" value="WARNING"/>
		<parameter name="logFile" value="AAA-Profiltool-Log.xml"/>
	</log>
	<targets>
		<Target class="de.adv_online.aaa.profiltool.Profil" mode="enabled">
			<targetParameter name="Verzeichnis" value="Ausgaben/Profile"/>
			<targetParameter name="Modellart" value="DLKM"/>
			<targetParameter name="Profil" value="TestMIN"/>
			<targetParameter name="Quelle" value="Neu_Minimal"/>
			<targetParameter name="Ziel" value="Datei"/>
			<!--
			<targetParameter name="Quelle" value="Neu_Maximal"/>
			<targetParameter name="Quelle" value="DateiModell"/>
			<targetParameter name="Quelle" value="Modell"/>
			<targetParameter name="Ziel" value="Modell"/>
			<targetParameter name="Ziel" value="Ohne"/>
			-->
		</Target>
	</targets>
